APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_DB=rag_assistant
POSTGRES_USER=rag_assistant
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://rag_assistant:local-development-only@127.0.0.1:5432/rag_assistant

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=rag-assistant
JWT_AUDIENCE=rag-assistant-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10

EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIMENSIONS=1024
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CONCURRENCY=2
EMBEDDING_CONNECT_TIMEOUT_SECONDS=10
EMBEDDING_READ_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=3

CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=600
CHUNK_PARAGRAPH_OVERLAP=1
INGESTION_LEASE_SECONDS=300

OBJECT_STORE_BACKEND=local
LOCAL_OBJECT_STORE_ROOT=.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
